# Varsayilan: SQLite (dosya tabanli, kurulum gerektirmez)
DATABASE_URL=sqlite:///./market_advisor.db

# PostgreSQL'e gecmek icin yukaridaki satiri yorum satirina alip asagidakini kullanin:
# DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/market_advisor

# Piyasa fiyati saglayicisi: su an sadece "mock" (simulasyon) mevcut.
# Gercek scraper eklendiginde app/scraper.py icine yeni bir saglayici ekleyip
# burada adini belirtmeniz yeterli olacak.
MARKET_PROVIDER=mock
